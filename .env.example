# Postgres from docker-compose.yml (host port 5433 to avoid clashing with a local 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/wavy"

# Database used by `pnpm test`. Created by docker/init-test-db.sql.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/wavy_test"

# HMAC key for the signed session cookie. Any non-empty string works locally.
AUTH_SECRET="dev-secret-change-me"
